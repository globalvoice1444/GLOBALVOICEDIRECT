<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # 2026-10-31: old marketing form, trailing-slash variant -> new form (one hop)
    RewriteRule ^marketing-form/$ /user/marketing-form [R=301,L]

    # Laravel's public/ is the real document root, but cPanel serves this
    # project's repo root instead. Forward every request into public/ so
    # its own front controller and asset files are reachable from "/".
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

#hide a Specifuc File

<Files .env>
order allow,deny
Deny from all
</Files>

